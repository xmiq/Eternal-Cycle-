<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EternalCycleRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\..\..'))</EternalCycleRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EternalCycle.Persistence.Mcp\EternalCycle.Persistence.Mcp.csproj" />
    <ProjectReference Include="..\..\..\..\rules-compiler-dotnet\src\EternalCycle.Rules\EternalCycle.Rules.csproj" />
    <Using Include="EternalCycle.Rules" />
    <Compile Include="..\..\..\..\rules-compiler-dotnet\tests\Shared\CompiledRulesImportFixtures.cs" Link="Shared\CompiledRulesImportFixtures.cs" />
    <Compile Include="..\..\..\..\rules-compiler-dotnet\tests\Shared\CanonicalVocabularyPayload.cs" Link="Shared\CanonicalVocabularyPayload.cs" />
    <Compile Include="..\..\..\..\rules-compiler-dotnet\tests\Shared\CompiledRuleQualityEvidence.cs" Link="Shared\CompiledRuleQualityEvidence.cs" />
    <None Include="..\..\..\..\rules-compiler-dotnet\fixtures\compiled-rule-retrieval\*"
          Link="RetrievalQualityFixture\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\..\..\rules-compiler-dotnet\tests\Shared\MemoryStoreCompiledRulesArtifactProvider.cs" Link="Shared\MemoryStoreCompiledRulesArtifactProvider.cs" />
    <None Include="..\..\..\..\rules-compiler-dotnet\fixtures\canonical-vocabulary\*.json"
          Link="CanonicalVocabularyFixture\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\EternalCycle.Persistence.Mcp\DISTRIBUTION.json"
          Link="distribution-metadata.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(EternalCycleRepositoryRoot)\examples\conformance\compiled-rules-artifact\v1\*.json"
          Link="Fixtures\CompiledRulesArtifact\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
